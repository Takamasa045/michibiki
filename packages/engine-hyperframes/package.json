{
  "name": "@michibiki/engine-hyperframes",
  "version": "0.1.2",
  "description": "HyperFrames-style browser motion adapter for Michibiki.",
  "type": "module",
  "license": "MIT",
  "author": "Takamasa Ito",
  "keywords": [
    "video",
    "hyperframes",
    "html",
    "motion",
    "video-router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takamasa045/michibiki.git",
    "directory": "packages/engine-hyperframes"
  },
  "bugs": {
    "url": "https://github.com/Takamasa045/michibiki/issues"
  },
  "homepage": "https://github.com/Takamasa045/michibiki#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "files": [
