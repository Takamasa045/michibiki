{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "rangeStrategy": "bump",
  "automerge": false,
  "packageRules": [
    {
      "description": "Group GitHub Actions updates into one weekly PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group non-major npm updates outside the video-engine set.",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "excludePackageNames": [
        "hyperframes",
        "@hyperframes/engine",
        "@hyperframes/producer",
        "remotion",
        "@remotion/cli",
        "@remotion/renderer",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@editframe/api",
        "@editframe/cli",
        "@editframe/create",
        "@editframe/elements",
        "@editframe/react"
      ],
      "groupName": "npm non-major",
      "groupSlug": "npm-non-major"
    },
    {
      "description": "Keep video engine packages and generated project runtime versions updated together.",
      "matchDatasources": ["npm"],
      "matchPackageNames": [
        "hyperframes",
        "@hyperframes/engine",
        "@hyperframes/producer",
        "remotion",
        "@remotion/cli",
        "@remotion/renderer",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@editframe/api",
        "@editframe/cli",
        "@editframe/create",
        "@editframe/elements",
        "@editframe/react"
      ],
      "groupName": "video engines",
      "groupSlug": "video-engines",
      "prPriority": 10,
      "rangeStrategy": "bump"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Remotion standalone project dependency constants.",
      "managerFilePatterns": [
        "/(^|/)packages/engine-remotion/src/remotion-engine\\.ts$/",
        "/(^|/)packages/engine-editframe/src/editframe-versions\\.ts$/"
      ],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+const [A-Z_]+_VERSION = \"(?<currentValue>[^\"]+)\";"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}npm{{/if}}"
    }
  ]
}
